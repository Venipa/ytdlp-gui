# Job failure copy, one message per ErrorCode (key = ErrorCode::message_key). Plain words, say what to do.
err-private = This video is private.
err-geo = Not available in your country. Try a proxy in Settings.
err-login = Sign in needed. Add cookies in Settings.
err-age-restricted = This video is age-restricted. Add cookies from a signed-in browser in Settings.
err-unavailable = This video is no longer available.
err-unsupported-url = This link isn't supported.
err-format-unavailable = That quality isn't available for this video. Pick another one.
err-rate-limited = Too many requests. Trying again soon.
err-rate-limited-wait = Too many requests. Trying again in { $seconds } seconds.
err-network = No connection. Try again.
err-ssl = Couldn't make a secure connection. Check your date and time, proxy or antivirus.
err-ffmpeg = ffmpeg is missing. Download it in Settings, then try again.
err-js-runtime-missing = YouTube needs deno. Download it in Settings, then try again.
err-disk-full = The disk is full.
err-permission = Can't write to this folder. Pick another one in Settings.
err-cookies-locked = Couldn't read the browser's cookies. Close the browser, or use a cookies file.
err-cancelled = Cancelled.
err-unknown = Something went wrong. See the log.
