{
  "name": "@ytdlpd/desktop",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "cargo run -p ytdlpd",
    "build": "cargo build -p ytdlpd --release",
    "check": "cargo check --workspace",
    "setup": "bun scripts/setup.ts",
    "dev:hot": "dx serve --hot-patch --package ytdlpd",
    "release:win": "pwsh -NoProfile -File scripts/package-windows.ps1 -Arch x64",
    "release:mac": "bash scripts/package-macos.sh"
  }
}
