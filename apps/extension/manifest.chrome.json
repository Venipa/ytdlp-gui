{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "description": "__MSG_ext_description__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "contextMenus"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "__MSG_ext_name__", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle" }
  ]
}
