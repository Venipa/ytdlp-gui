{
  "name": "ytdlpd",
  "private": true,
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @ytdlpd/desktop dev",
    "build": "bun run --filter @ytdlpd/desktop build",
    "check": "bun run --filter @ytdlpd/desktop check",
    "setup": "bun run --filter @ytdlpd/desktop setup",
    "dev:hot": "bun run --filter @ytdlpd/desktop dev:hot",
    "release:win": "bun run --filter @ytdlpd/desktop release:win",
    "release:mac": "bun run --filter @ytdlpd/desktop release:mac",
    "web:dev": "bun run --filter @ytdlpd/web dev",
    "web:build": "bun run --filter @ytdlpd/web build",
    "web:stats": "bun run --filter @ytdlpd/web stats",
    "ext:build": "bun run --filter @ytdlpd/extension build"
  }
}
